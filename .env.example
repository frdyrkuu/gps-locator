# Copy to .env.local for development; never commit real credentials.
# Neon pooled application URL (hostname ends in -pooler).
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/neondb?sslmode=require
# Neon direct URL for Prisma migrations (no -pooler in hostname).
DIRECT_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require&connect_timeout=20
# Generate a random high-entropy value; never reuse the seed password.
AUTH_SECRET=replace-with-a-long-random-secret
# Only required when running npm run db:seed; password must be 12+ characters.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=replace-with-a-strong-password
# Vercel attaches this as Authorization: Bearer <CRON_SECRET> to the daily job.
CRON_SECRET=replace-with-a-different-long-random-secret
# Public tile template; OSM's public tiles are for modest interactive development only.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Public attribution HTML required by the chosen provider (OSM attribution is always shown).
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
