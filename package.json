{
  "name": "gps-locator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:client-secrets",
    "test:client-secrets": "node --import tsx --test tests/release/client-secrets.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --import tsx --test tests/integration/*.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "1.2.0",
    "@next/env": "16.4.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "6.14.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "postcss": "^8.5.30",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "shadcn": "4.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
